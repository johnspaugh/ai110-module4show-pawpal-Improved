# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
# Without a key PawPal+ runs in demo mode (a rule-based stand-in for the model).
# ANTHROPIC_API_KEY=

# Optional: use a different model (for example a cheaper one while developing).
# PAWPAL_MODEL=claude-opus-5-5

# Optional: set to 1 to force demo mode even when a key is present.
PAWPAL_DEMO=1
