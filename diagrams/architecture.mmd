flowchart TD
    %% All components below are implemented. File names are in each box.

    User([Pet owner])

    subgraph INPUT["INPUT"]
        Request["Owner notes (plain English)<br/>e.g. Biscuit takes arthritis medicine<br/>(app.py text box)"]
        Forms["Streamlit forms: owner, pet, task<br/>validates HH:MM start time<br/>(app.py)"]
    end

    subgraph PROCESS["PROCESS"]
        direction TB
        Agent["Planning agent (agent.py)<br/>plan, retrieve, act, check, retry (max 3)"]
        Retriever["Retriever, RAG (rag.py)<br/>keyword search, species filter,<br/>notes matched per pet"]
        KB[("Knowledge base (knowledge/)<br/>dog, cat, senior pets, medication,<br/>other pets")]
        LLM["LLM call (llm.py)<br/>live Anthropic model, or demo stand-in<br/>when no API key; strict JSON output"]
        Validator["Output validator (agent.py)<br/>schema, priority, minutes, HH:MM,<br/>source must be a retrieved guide"]

        subgraph CORE["Core logic (pawpal_system.py)"]
            Owner["Owner"]
            Pet["Pet"]
            Task["Task"]
            Scheduler["Scheduler<br/>generate_daily_plan, detect_conflicts,<br/>sort_by_time, filter_tasks"]
        end

        Evaluator["Evaluator, self-check (agent.py)<br/>time budget, overlaps,<br/>essential tasks not skipped<br/>runs on a sandbox copy of the owner"]
        Log[("pawpal.log (logging_setup.py)<br/>every step, tool call, retry")]
    end

    subgraph OUTPUT["OUTPUT"]
        Preview["Proposed plan preview<br/>+ checker problems<br/>+ Why this plan? with cited sources"]
        Saved["Accepted tasks added to the Owner<br/>(kept in st.session_state)"]
    end

    subgraph CHECKS["HUMAN AND TEST CHECKS"]
        Human{{"Human review<br/>owner accepts or rejects"}}
        Tests["Automated tests (pytest)<br/>retrieval, validation, agent loop<br/>with a fake model, app flow"]
        Fallback["Fallback: non-AI scheduling<br/>if the model call fails"]
    end

    User --> Request
    User --> Forms
    Forms -->|add_pet, add_task| Owner
    Request --> Agent

    Agent -->|1. look up guidance| Retriever
    Retriever <-->|top 3 chunks + source names| KB
    Retriever -->|retrieved text| Agent
    Agent -->|2. prompt + retrieved text| LLM
    LLM -->|proposed tasks| Validator
    Validator -->|valid tasks only| Agent
    Validator -.->|invalid: reject and retry| Agent
    Agent -->|3. add_pet, add_task| Owner
    Owner -->|has many| Pet
    Pet -->|needs many| Task
    Agent -->|4. generate_daily_plan| Scheduler
    Scheduler -->|reads tasks| Owner
    Scheduler -->|plan, skipped, conflicts| Evaluator
    Evaluator -->|problems found: revise| Agent
    Evaluator -->|checks pass| Preview

    Agent -.-> Log
    Retriever -.-> Log
    Evaluator -.-> Log

    Preview --> Human
    Human -->|accept| Saved
    Human -->|reject| Request
    Saved --> User

    LLM -.->|model error| Fallback
    Fallback --> Scheduler

    Tests -.->|verifies| Retriever
    Tests -.->|verifies| Validator
    Tests -.->|verifies| Agent
    Tests -.->|verifies| Scheduler

